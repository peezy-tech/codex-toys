{
  "name": "@meka/app",
  "version": "0.1.0",
  "private": true,
  "description": "Meka private-socket runtime for local coding harnesses.",
  "license": "Apache-2.0",
  "bin": {
    "meka": "bin/meka.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && chmod 755 dist/main.js",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm --filter @meka/sdk run build && pnpm run build"
  },
  "dependencies": {
    "@meka/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
