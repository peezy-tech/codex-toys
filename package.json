{
	"name": "agent-harness-starter",
	"version": "0.1.0",
	"description": "Starter monorepo for unattended local Codex and Claude Code runners.",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"build": "pnpm -r --filter @codex-appkit/codex --filter @codex-appkit/claude --filter @codex-appkit/harness --filter @codex-appkit/http --filter @codex-appkit/cli --filter @codex-appkit/example-node-run --filter @codex-appkit/example-vite-runner run build",
		"check:types": "pnpm -r --filter @codex-appkit/codex --filter @codex-appkit/claude --filter @codex-appkit/harness --filter @codex-appkit/http --filter @codex-appkit/cli --filter @codex-appkit/example-node-run --filter @codex-appkit/example-vite-runner run check:types",
		"test": "vp test run",
		"bindings:generate": "tsx scripts/generate-bindings.ts",
		"dev:runner": "pnpm --filter @codex-appkit/example-vite-runner dev"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
