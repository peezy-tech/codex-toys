{
	"name": "codex-app-server-starter",
	"version": "0.1.0",
	"description": "Starter monorepo for building TypeScript utilities on the Codex app-server.",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"build": "pnpm -r --filter @codex-appkit/app-server --filter @codex-appkit/microbridge --filter @codex-appkit/http --filter codex-appkit --filter @codex-appkit/example-node-thread-list --filter @codex-appkit/example-vite-thread-dashboard run build",
		"check:types": "pnpm -r --filter @codex-appkit/app-server --filter @codex-appkit/microbridge --filter @codex-appkit/http --filter codex-appkit --filter @codex-appkit/example-node-thread-list --filter @codex-appkit/example-vite-thread-dashboard run check:types",
		"test": "vp test run",
		"bindings:generate": "tsx scripts/generate-bindings.ts",
		"dev:dashboard": "pnpm --filter @codex-appkit/example-vite-thread-dashboard dev"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
