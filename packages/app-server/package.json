{
	"name": "@codex-appkit/app-server",
	"version": "0.1.0",
	"description": "Typed Codex app-server client, transport, auth, JSON-RPC helpers, and generated protocol bindings.",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/app-server/auth.d.ts",
			"import": "./dist/app-server/auth.js"
		},
		"./client": {
			"types": "./dist/app-server/client.d.ts",
			"import": "./dist/app-server/client.js"
		},
		"./events": {
			"types": "./dist/app-server/events.d.ts",
			"import": "./dist/app-server/events.js"
		},
		"./generated": {
			"types": "./dist/app-server/generated/index.d.ts",
			"import": "./dist/app-server/generated/index.js"
		},
		"./generated/*": {
			"types": "./dist/app-server/generated/*.d.ts",
			"import": "./dist/app-server/generated/*.js"
		},
		"./json": {
			"types": "./dist/json.d.ts",
			"import": "./dist/json.js"
		},
		"./rpc": {
			"types": "./dist/app-server/rpc.d.ts",
			"import": "./dist/app-server/rpc.js"
		},
		"./stdio": {
			"types": "./dist/app-server/stdio-transport.d.ts",
			"import": "./dist/app-server/stdio-transport.js"
		}
	},
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"build": "pnpm run clean && tsc -p tsconfig.build.json",
		"check:types": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
