{
	"name": "@codex-appkit/claude",
	"version": "0.1.0",
	"description": "Local Claude Code adapter backed by the Claude Agent SDK.",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"build": "pnpm run clean && tsc -p tsconfig.build.json",
		"check:types": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.206"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
