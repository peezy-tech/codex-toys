{
  "name": "@meka/workflow",
  "version": "0.1.0",
  "description": "Effect-based authoring contract for Meka TypeScript workflows.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "test": "vp test run --root ../.. packages/workflow/test/workflow.test.ts"
  },
  "dependencies": {
    "effect": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
